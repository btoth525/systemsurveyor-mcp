# Copy to .env (git-ignored) and fill in. Never commit .env.
MCP_TOKEN=generate-with-openssl-rand-hex-32
PUBLIC_URL=
ALLOW_WRITES=false
OWNER_USER_ID=
WRITE_SURVEYS=
SS_ACCOUNT_ID=
SS_TEAM_ID=
ALERT_WEBHOOK=
LABOR_RATE=
CABLE_PER_FT=
MARKUP_PCT=0
TAX_PCT=0
TZ=UTC
# deploy.sh / push_token.sh only
DEPLOY_HOST=user@docker-host.local
REMOTE_DIR=/opt/systemsurveyor-mcp
SSH_KEY=~/.ssh/id_ed25519
